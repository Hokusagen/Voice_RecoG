# Виртуальное окружение
venv/
.venv/
env/

# Сборка и кэш Python
__pycache__/
*.py[cod]
build/
dist/

# Временные файлы и веса моделей
*.mp3
*.wav
models/

# Локальные настройки и история
config.json
history.json

# Номер сборки: впечатывается build.py на время работы PyInstaller
src/_build.py

# Ярлык: пути в нём принадлежат конкретной машине, делается shortcut.py
*.lnk

# Инструкции для других агентов: у каждого свои, в репозитории живёт CLAUDE.md
AGENTS.md

# Лаборатория стекла: снимки и сырой отчёт исследования остаются локально
design/glass/shots/
design/glass/research.json
# Профили безголового Edge, если TEMP указывает в папку лаборатории
design/glass/vt-edge-*/
